# Copy to .env and fill in from Supabase dashboard → Settings → API.
# Use ONLY the publishable/anon key here. NEVER the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-only (set these in Vercel → Project → Settings → Environment Variables) ──
# Never prefix with VITE_ and never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional tuning:
# LOOKUP_MODEL=claude-haiku-5-5
# LOOKUP_DAILY_CAP=150
# EXPLAIN_DAILY_CAP=500
# LOOKUP_BLOCKED_DOMAINS=nykaa.com,tirabeauty.com
# WEB_SEARCH_TOOL_TYPE=web_search_20250305
