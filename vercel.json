{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/shelf-reminders",
      "schedule": "30 3 * * *"
    }
  ],
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/lookup.js": {
      "maxDuration": 60
    },
    "api/add-product.js": {
      "maxDuration": 60
    },
    "api/explain.js": {
      "maxDuration": 30
    },
    "api/suggest-dupes.js": {
      "maxDuration": 60
    }
  }
}
